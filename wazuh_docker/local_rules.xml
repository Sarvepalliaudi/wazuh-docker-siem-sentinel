<group name="local,authentication_failed,">
  <rule id="100510" level="10" frequency="5" timeframe="60">
    <if_matched_group>authentication_failed</if_matched_group>
    <same_source_ip />
    <description>Repeated authentication failures (SSH 5710 / system login 5503) from one source IP.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100511" level="12" frequency="3" timeframe="60">
    <if_matched_group>sudo_failed</if_matched_group>
    <same_source_ip />
    <description>Rapid sudo or root privilege escalation failure burst.</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>
</group>
